DATABASE_URL="mysql://root:123789@localhost:3306/luminastudio"
JWT_SECRET="replace-me-in-production"
PORT=3000

# WeChat Mini Program login (jscode2session)
WECHAT_APPID="your-appid"
WECHAT_SECRET="your-secret"

# WeChat Pay API v3 (production payment)
WECHAT_MCH_ID=""
WECHAT_API_V3_KEY=""
WECHAT_MCH_SERIAL_NO=""
WECHAT_PRIVATE_KEY_PATH=""
WECHAT_PAY_NOTIFY_URL="https://your-domain.com/api/payments/notify"

# Required in production. Dev fallback is luminastudio-dev-secret.
NODE_ENV="development"

# Dev: leave WECHAT_APPID/SECRET as placeholders to use dev_openid_demo + simulated payment
